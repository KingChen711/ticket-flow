<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!--
      EF Core family pinned to one exact version everywhere. Npgsql's own manifest floors
      Microsoft.EntityFrameworkCore(.Relational) to an older patch than what
      Microsoft.EntityFrameworkCore.Design pulls in — without an explicit direct reference,
      that caused a real MSB3277 assembly version conflict (Infrastructure's compiled DLL
      referenced 10.0.9, but Catalog.Api resolved 10.0.4 transitively via Npgsql).
      Projects that use EF Core types directly (Infrastructure) reference these two explicitly.
    -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageVersion Include="Grpc.Net.ClientFactory" Version="2.80.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.82.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.31.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!--
      API docs: native OpenAPI generation + Scalar UI (not Swashbuckle — deprecated in this
      repo, see docs/phase-1-plan.md). Microsoft.AspNetCore.OpenApi 10.0.9 still floors
      Microsoft.OpenApi at the vulnerable 2.0.0 (GHSA-v5pm-xwqc-g5wc, not yet patched
      upstream). Pinned to the latest 2.x patch instead of jumping to 3.x — AspNetCore.OpenApi's
      bundled XML-comment source generator is compiled against the 2.x API shape (3.x made
      IOpenApiMediaType.Example read-only, which breaks that generator at compile time).
    -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Phase 7 Commit 2 — Keycloak JWT validation. Not part of the ASP.NET Core shared
         framework despite living under the Microsoft.AspNetCore.* namespace (confirmed by a
         real build failure before adding this — CS0234, namespace didn't resolve via
         FrameworkReference alone). Pinned to match the other ASP.NET Core 10.0.9 packages above. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.9" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.10.0" />
    <!--
      Phase 10 Commit 1 — TicketFlow.Observability, wired into every service's Program.cs
      (AddTicketFlowObservability). All official OpenTelemetry .NET, Apache-2.0, no license trap.
      OpenTelemetry.Instrumentation.GrpcNetClient has NO stable release — 1.17.0-beta.1 is the
      best NuGet has (confirmed via `dotnet add package` refusing the stable resolve and offering
      only the beta); this instrumentation package has stayed pre-1.0 for its whole life upstream,
      not a temporary gap specific to this pin. Used only for the ordering→reservation gRPC client
      span (Commit 1); accepted as the only real option, same spirit as accepting QuestPDF's
      in-code license split or AWSSDK's Apache-2.0 confirmation elsewhere in this file.
      OpenTelemetry.Exporter.Prometheus.AspNetCore (Commit 3) has the exact same no-stable-release
      situation — same acceptance logic, same beta line.
    -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.17.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.GrpcNetClient" Version="1.17.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <!--
      Phase 10 Commit 4 — Serilog → Elasticsearch → Kibana. Serilog/Serilog.Sinks.Console/
      Serilog.Extensions.Logging are Apache-2.0 (Serilog org), no license trap. Serilog.Enrichers.Span
      (RehanSaeed, MIT) pulls TraceId/SpanId/ParentId straight from Activity.Current into every log
      event's properties — confirmed via a live probe that this alone (no message-template
      placeholder needed) is enough for the ECS formatter below to map them onto the real
      `trace.id`/`span.id` fields, not just `labels.*`.

      Elastic.Serilog.Sinks pinned to 8.12.3, NOT the latest 9.0.0 — real bug found via a live probe
      against this repo's actual ES 8.15.3 container before writing any production code: 9.0.0 ships
      an ECS 9.0.0 component-template mapping that sets `synthetic_source_keep` on the `tags` field,
      a mapper parameter ES 8.15.3 doesn't recognize (`mapper_parsing_exception: unknown parameter
      [synthetic_source_keep]`) — the sink crashes at construction (BootstrapMethod.Failure) before
      a single service can even start. 8.12.3 (ECS 8.11.0 template) bootstraps cleanly against this
      exact server version. Same Apache-2.0 license as 9.0.0, official Elastic-maintained package,
      successor to the now-deprecated `Serilog.Sinks.Elasticsearch` (confirmed via that package's own
      NuGet description pointing here).
    -->
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Enrichers.Span" Version="3.1.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Elastic.Serilog.Sinks" Version="8.12.3" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.11" />
    <PackageVersion Include="StackExchange.Redis" Version="3.0.17" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.9" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Real Redis in a container (Commit 10, docs/phase-2-plan.md) — no mocking the
         concurrency primitive that's the actual thing under test. -->
    <PackageVersion Include="Testcontainers.Redis" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Elasticsearch" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.MongoDb" Version="4.13.0" />
    <!-- Phase 12 Commit 1 — real failure-boundary harness. Keep every Testcontainers module on
         the same release so the shared core/reaper behavior cannot drift between dependencies. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.13.0" />
    <!-- Throughput/load measurement (Commit 11) — companion to Commit 10's correctness proof,
         not a replacement for it. -->
    <PackageVersion Include="NBomber" Version="6.5.0" />
    <!--
      Pinned to the last OSS release line. MassTransit 9.x (latest on NuGet as of this pin,
      9.1.2) moved to a commercial license — 8.x is the final free line and still receives
      patches. 8.5.10 is the newest 8.x and ships a first-class net10.0 target (not just
      netstandard2.0 fallback), confirmed via its nuspec before pinning.
    -->
    <PackageVersion Include="MassTransit" Version="8.5.10" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.5.10" />
    <PackageVersion Include="MassTransit.EntityFrameworkCore" Version="8.5.10" />
    <!--
      PurchaseSaga (Phase 5 Commit 4) persists via Marten, same Postgres as the ordering event
      store. NuGet package id is "MassTransit.Marten" but the DLL it ships is actually named
      MassTransit.MartenIntegration.dll (confirmed via reflection probe before pinning — the
      registration extension is MassTransit.MartenSagaRepositoryRegistrationExtensions.MartenRepository).
      Same 8.5.10 free/OSS line as core MassTransit (9.x+ is commercial, see above).
    -->
    <PackageVersion Include="MassTransit.Marten" Version="8.5.10" />
    <!--
      Phase 6 Commit 6 — Kafka Rider. Same 8.5.10 free/OSS line as core MassTransit, Apache-2.0,
      confirmed to ship a first-class net10.0 target. Confirmed via a real probe against a live
      Kafka broker (produce -> real topic -> consume, full round-trip match) before wiring this
      into AddTicketFlowMessaging — see that file's doc comment for the topic-creation findings.
    -->
    <PackageVersion Include="MassTransit.Kafka" Version="8.5.10" />
    <!--
      Phase 6 Commit 7 — ClickHouse client for Analytics. MIT license, ADO.NET-style
      (DbConnection/DbCommand). No net10.0-specific target (only net8.0/.NETStandard2.1/.NET
      Framework) but forward-compatible, same as MongoDB.Driver's pin above. Confirmed via a real
      probe against a live ClickHouse container: named parameters use {name:Type} placeholder
      syntax in the SQL text (not a magic AddParameter helper — standard DbCommand.CreateParameter
      + Parameters.Add), and ReplacingMergeTree only dedups on background merge — SELECT ... FINAL
      is what gives correct deduped results at query time without forcing an OPTIMIZE.
    -->
    <PackageVersion Include="ClickHouse.Client" Version="7.14.0" />
    <!--
      Event store + document DB for Ordering (Phase 4, Ch7). MIT license, confirmed via nuspec
      to ship a first-class net10.0 target (not just netstandard fallback) — no license
      trap here, unlike MassTransit/MediatR.
    -->
    <PackageVersion Include="Marten" Version="9.15.2" />
    <!--
      Runtime-only counterpart Ordering.Domain needs (see its csproj comment): Marten's
      source-generated Evolve/Apply dispatcher code references JasperFx.Events types directly.
      This is the transport-agnostic event-sourcing core Marten builds on — no Postgres/Npgsql
      dependency, MIT, net10.0 target confirmed via nuspec.
    -->
    <PackageVersion Include="JasperFx.Events" Version="2.27.0" />
    <!--
      Resiliency (Phase 5 Ch10) — v8 ResiliencePipeline API, not the old v7 Policy API.
      BSD-3-Clause, free, no license trap unlike MassTransit/MediatR.
    -->
    <PackageVersion Include="Polly.Core" Version="8.7.0" />
    <!--
      Phase 10 Commit 5 — rủi ro số 3 (metric circuit-breaker Polly). Same BSD-3-Clause, same
      Polly org, same 8.7.0 line as Polly.Core above — confirmed via NuGet before pinning. Real
      finding from a live probe (MeterListener sniffing every Meter published while running the
      exact pipeline shape PaymentGatewayResiliencePipeline builds): `Polly.Core` alone emits NO
      Polly-specific metric — only the unrelated built-in `System.Runtime`/`dotnet.exceptions`
      counter fired. The `Polly` meter (`resilience.polly.strategy.events` Counter&lt;int&gt;,
      tagged `event.name` — `OnCircuitOpened`, `OnRetry`, etc.) only exists once
      `Polly.Extensions`'s `.ConfigureTelemetry(...)` is called on the pipeline builder — this
      package is that missing piece, not an alternative to Polly.Core.
    -->
    <PackageVersion Include="Polly.Extensions" Version="8.7.0" />
    <!--
      Ticketing (Phase 5 Ch9/10 participant). QuestPDF's NuGet license metadata says MIT, but
      the library ALSO enforces its own Community/Commercial split in code via
      QuestPDF.Settings.License — must be set to LicenseType.Community at startup (free for
      non-commercial/learning use, revenue under a threshold for companies). Not a NuGet-level
      license trap like MassTransit/MediatR, but a real term to know about — set explicitly in
      TicketFlow.Ticketing.Api Program.cs.
    -->
    <PackageVersion Include="QuestPDF" Version="2026.7.1" />
    <!-- MIT, free. QR generation only — Phase 5 issues tickets, doesn't verify them (gate
         scanning is Phase 8), so no signing/crypto here yet (see phase-5-plan.md backlog). -->
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <!-- Apache-2.0, free. S3-compatible client for the MinIO container (Commit 1). -->
    <PackageVersion Include="Minio" Version="7.0.0" />
    <!--
      Phase 6 Commit 2 — official Elasticsearch .NET client, Apache-2.0, no license trap.
      Confirmed via nuspec to ship a first-class net10.0 target. Pinned to latest 8.x (matches
      the ES 8.15.3 server pinned in docker-compose.infra.yml — client/server major-version
      compatibility, not a hard requirement to match patch versions).
    -->
    <PackageVersion Include="Elastic.Clients.Elasticsearch" Version="8.19.23" />
    <!--
      Phase 6 Commit 3 — official MongoDB driver, Apache-2.0. Latest 3.10.0 has no net10.0-specific
      target group (only net6.0/.NETStandard2.1) but is forward-compatible. Confirmed via a real
      probe against a live mongo:7 container that v3.x removed the old implicit "CSharpLegacy" Guid
      representation — BsonSerializer.RegisterSerializer(new GuidSerializer(GuidRepresentation.
      Standard)) must be called explicitly at startup or any Guid-typed field throws
      BsonSerializationException.
    -->
    <PackageVersion Include="MongoDB.Driver" Version="3.10.0" />
    <!--
      Phase 9 Commit 1 — AWS Lambda .NET class-library handler model (classic, not the
      RuntimeSupport/executable style — that's for custom-runtime/Native AOT deployments, and
      this project targets the plain managed dotnet10 runtime, packaged with
      Amazon.Lambda.Tools' `dotnet lambda package`). Both Apache-2.0, official AWS packages, no
      license trap.
    -->
    <PackageVersion Include="Amazon.Lambda.Core" Version="3.1.1" />
    <PackageVersion Include="Amazon.Lambda.Serialization.SystemTextJson" Version="3.0.0" />
    <!--
      Phase 9 Commit 2 — S3 bucket notification event shape (ThumbnailPoster trigger). Official
      AWS, Apache-2.0. (Amazon.Lambda.APIGatewayEvents was tried first for the media Lambdas —
      dropped once Function URLs turned out not to work for gateway routing here, see
      UploadPosterFunction's doc comment; a direct SDK Invoke call doesn't need an HTTP envelope.)
    -->
    <PackageVersion Include="Amazon.Lambda.S3Events" Version="4.0.0" />
    <!-- Apache-2.0, official AWS SDK. Same S3-compatible client family already used for MinIO
         (Minio package) — this one talks to LocalStack's S3 emulation instead. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.101.2" />
    <!--
      Poster thumbnail resize (Commit 2). MIT license — chosen over SixLabors.ImageSharp 3.x,
      which is Split-Licensed (free under Apache-2.0 only below $1M/year revenue as a direct
      dependency, confirmed via a real license-page lookup, not assumed — same class of decision
      as the MassTransit/Duende/Module Federation license traps avoided earlier in this project).
      `.NativeAssets.Linux.NoDependencies` specifically statically links what a normal Linux
      SkiaSharp install expects from system packages (fontconfig etc.) — exactly the missing-libs
      failure mode a minimal Lambda execution image would otherwise hit; confirmed via a real
      resize invoked inside the actual dotnet10 Lambda container before committing to this pick.
    -->
    <PackageVersion Include="SkiaSharp" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <!-- Gateway's thin proxy to the media Lambdas (Commit 2, mục 3) and ticketing's
         RenderTicketPdf call (Commit 3) — both invoke by stable function name via the Lambda
         Invoke API rather than routing raw HTTP through YARP. Apache-2.0, official AWS SDK. -->
    <PackageVersion Include="AWSSDK.Lambda" Version="4.0.104" />
    <!--
      Phase 9 Commit 4 — EventReminderTimer Lambda has no ASP.NET Core builder of its own to hang
      DI/config off of (AWSProjectType=Lambda is a bare class library, not Sdk.Web), so it stands
      up a minimal Microsoft.Extensions.Hosting generic host to reuse AddTicketFlowMessaging (same
      RabbitMQ retry/endpoint-naming config every other service gets) instead of hand-rolling a
      raw MassTransit bus. Pinned to the same 10.0.9 line as the other Microsoft.Extensions.*
      packages already pinned above, for the aligned-.NET-10-runtime-family reason those carry.
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
  </ItemGroup>
</Project>
