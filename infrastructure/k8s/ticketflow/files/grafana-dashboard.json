{
  "title": "TicketFlow - RED + Business",
  "uid": "ticketflow-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (per service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (job) (rate({\"http.server.request.duration_seconds_count\"}[1m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate - 5xx (per service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (job) (rate({\"http.server.request.duration_seconds_count\", \"http.response.status_code\"=~\"5..\"}[1m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Duration p95 (per service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate({\"http.server.request.duration_seconds_bucket\"}[5m])))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Ve ban / phut",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate({\"ticketflow.tickets.sold_total\"}[1m])) * 60",
          "legendFormat": "tickets/min",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Payment reconciliation backlog",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (kind) ({\"ticketflow.payment.reconcile_backlog\"})",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Unknown / manual-review operations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(increase({\"ticketflow.payment.charge_total\", \"outcome\"=\"unknown\"}[5m])) + sum(increase({\"ticketflow.payment.refund_total\", \"outcome\"=\"unknown\"}[5m]))",
          "legendFormat": "payment unknown",
          "refId": "A"
        },
        {
          "expr": "sum(increase({\"ticketflow.saga.manual_review_total\"}[5m])) + sum(increase({\"ticketflow.payment.manual_review_total\"}[5m]))",
          "legendFormat": "manual review",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "title": "Saga deadline fires",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (state) (increase({\"ticketflow.saga.deadlines_total\"}[5m]))",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    }
  ]
}
