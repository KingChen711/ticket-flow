# Biến cho `docker compose` (Compose tự đọc file `.env` ở thư mục gốc).
# Sao chép: cp .env.example .env

# Bắt buộc nếu muốn có PDF vé, poster, nhắc lịch (AWS Lambda chạy trên LocalStack).
# Lấy token miễn phí (gói Hobby) tại https://app.localstack.cloud. Để trống thì LocalStack
# không khởi động được và bước phát vé của PurchaseSaga sẽ lỗi (đơn bị hủy, tiền được hoàn).
LOCALSTACK_AUTH_TOKEN=

# Tùy chọn - tần suất các Lambda hẹn giờ (mặc định rate(1 minute)).
# EVENT_REMINDER_SCHEDULE=rate(1 minute)
# HELLO_TIMER_SCHEDULE=rate(1 minute)

# Tùy chọn - endpoint MinIO mà Lambda dùng (mặc định minio:9000 trong mạng Compose).
# MINIO_ENDPOINT=minio:9000
