# Biến cho `pnpm dev` của customer-web. Sao chép: cp apps/customer-web/.env.example apps/customer-web/.env.local

# Chuỗi ngẫu nhiên riêng cho app này, tạo bằng: openssl rand -base64 32
AUTH_SECRET=

# Origin thật của app (không kèm path) - cần để callback OAuth đúng khi đi qua Multi-Zones.
AUTH_URL=http://localhost:3000

# Keycloak client của app này (đã có sẵn trong infrastructure/keycloak/realm-export.json).
AUTH_KEYCLOAK_ID=ticketflow-customer-web
# Lấy secret dev bằng:
#   jq -r '.clients[] | select(.clientId=="ticketflow-customer-web") | .secret' infrastructure/keycloak/realm-export.json
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/ticketflow

# API gateway (YARP) chạy trong docker compose.
GATEWAY_URL=http://localhost:8080
# Địa chỉ gateway mà trình duyệt thấy, dùng cho SignalR (sơ đồ ghế real-time).
# Server đọc biến này lúc chạy rồi truyền xuống client, nên không bị nhúng cứng vào bundle.
PUBLIC_GATEWAY_URL=http://localhost:8080

# Tùy chọn - địa chỉ 2 zone còn lại (mặc định localhost:3001 và localhost:3002).
# ORGANIZER_ZONE_URL=http://localhost:3001
# SCANNER_ZONE_URL=http://localhost:3002
