# Biến cho `pnpm dev` của organizer-dashboard. Sao chép: cp apps/organizer-dashboard/.env.example apps/organizer-dashboard/.env.local

# Chuỗi ngẫu nhiên riêng cho app này, tạo bằng: openssl rand -base64 32
AUTH_SECRET=

# Origin thật của app (không kèm path) - cần để callback OAuth đúng khi đi qua Multi-Zones.
AUTH_URL=http://localhost:3001

# Keycloak client của app này (đã có sẵn trong infrastructure/keycloak/realm-export.json).
AUTH_KEYCLOAK_ID=ticketflow-organizer-dashboard
# Lấy secret dev bằng:
#   jq -r '.clients[] | select(.clientId=="ticketflow-organizer-dashboard") | .secret' infrastructure/keycloak/realm-export.json
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=http://localhost:8180/realms/ticketflow

# API gateway (YARP) chạy trong docker compose.
GATEWAY_URL=http://localhost:8080
