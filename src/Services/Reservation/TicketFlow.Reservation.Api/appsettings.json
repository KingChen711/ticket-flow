{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=postgres;Port=5432;Database=ticketflow_reservation;Username=ticketflow;Password=ticketflow;Maximum Pool Size=16"
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Reservation": {
    "CacheReconcileMode": "RepairCache",
    "CacheReconcileIntervalSeconds": 60
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Username": "ticketflow",
    "Password": "ticketflow"
  },
  "Keycloak": {
    "Authority": "http://keycloak:8180/realms/ticketflow",
    "Audience": "ticketflow-api",
    "ValidIssuers": [
      "http://localhost:8180/realms/ticketflow",
      "http://keycloak:8180/realms/ticketflow"
    ]
  },
  "Elasticsearch": {
    "Uri": "http://elasticsearch:9200"
  },
  "Otlp": {
    "Endpoint": "http://ticketflow-jaeger:4317"
  }
}
