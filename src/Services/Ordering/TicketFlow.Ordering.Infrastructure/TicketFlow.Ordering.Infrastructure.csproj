<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for Microsoft.Extensions.Diagnostics.HealthChecks (IHealthCheck etc.), used by
         MartenHealthCheck — ships in the ASP.NET Core shared framework, not the plain BCL. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Marten" />
    <!-- MassTransitIntegrationEventPublisher (Commit 5) needs IPublishEndpoint's type — no
         RabbitMQ transport package here, that's wired at the Api composition root. -->
    <PackageReference Include="MassTransit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TicketFlow.Ordering.Application\TicketFlow.Ordering.Application.csproj" />
  </ItemGroup>

</Project>
