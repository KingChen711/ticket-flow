<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <!--
      Same requirement as TicketFlow.Ordering.Domain (see its csproj comment) — the source
      generator that dispatches MyOrdersProjection's Create/Apply methods (Commit 5) must run on
      the assembly that DEFINES the projected document type (MyOrderView), which lives here, not
      on the assembly that defines the projection class itself (Infrastructure). Analyzer-only +
      JasperFx.Events runtime, zero Marten-proper/Postgres dependency in Application.
    -->
    <PackageReference Include="Marten">
      <IncludeAssets>analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="JasperFx.Events" />
    <!--
      PurchaseSaga (Commit 4) is a MassTransitStateMachine — Application layer needs the core
      MassTransit abstractions (MassTransitStateMachine, SagaStateMachineInstance, State, Event)
      to define the state machine, but NOT MassTransit.RabbitMQ or MassTransit.Marten (transport
      + persistence wiring stays in Api/Program.cs, same split TicketFlow.Messaging already
      enforces for consumers in the other services).
    -->
    <PackageReference Include="MassTransit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TicketFlow.Ordering.Domain\TicketFlow.Ordering.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\TicketFlow.Contracts.Messaging\TicketFlow.Contracts.Messaging.csproj" />
  </ItemGroup>

</Project>
