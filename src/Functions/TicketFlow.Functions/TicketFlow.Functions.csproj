<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Marks this a Lambda project for Amazon.Lambda.Tools (`dotnet lambda package`) — classic
         class-library handler model targeting the managed dotnet10 runtime (docs/phase-9-plan.md
         Commit 1), not the executable/RuntimeSupport custom-runtime style. -->
    <AWSProjectType>Lambda</AWSProjectType>
    <!-- Lambda's managed runtime only loads runtime-specific assemblies it ships itself
         (System.*, netstandard, etc.) from its own base image, not from the deployment package —
         but everything else (this project's own DLLs + third-party NuGet deps) must be present in
         the zip since there's no separate "layer" step here. CopyLocalLockFileAssemblies ensures
         `dotnet publish`/`dotnet lambda package` actually copies transitive package DLLs into the
         output dir instead of assuming a shared framework has them. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" />
    <PackageReference Include="Amazon.Lambda.S3Events" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <!-- Commit 3 — moved here from Ticketing.Infrastructure along with the rendering they support
         (RenderTicketPdfFunction). Same versions, no license re-evaluation needed (Directory.
         Packages.props still carries the original QuestPDF Community-license note). -->
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="QRCoder" />
    <PackageReference Include="Minio" />
    <!-- Commit 4 — EventReminderTimer stands up a minimal generic host to reuse
         AddTicketFlowMessaging (see that method's project reference below) instead of hand-rolling
         a raw MassTransit bus; see TicketFlow.Functions.csproj's Directory.Packages.props pin
         comment for why a bare Lambda class library needs this explicitly. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.RabbitMQ" />
  </ItemGroup>

  <ItemGroup>
    <!-- Commit 14: ImageLimits is internal (it is not part of any Lambda's contract) but the
         decompression-bomb guard is worth testing directly rather than through an S3 round trip. -->
    <InternalsVisibleTo Include="TicketFlow.Phase12.HardeningTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\TicketFlow.Messaging\TicketFlow.Messaging.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\TicketFlow.Contracts.Messaging\TicketFlow.Contracts.Messaging.csproj" />
  </ItemGroup>

</Project>
