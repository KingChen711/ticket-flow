{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Catalog": {
    "BaseUrl": "http://catalog:8002/"
  },
  "Keycloak": {
    "Authority": "http://keycloak:8180/realms/ticketflow",
    "Audience": "ticketflow-api",
    "ValidIssuers": [
      "http://localhost:8180/realms/ticketflow",
      "http://keycloak:8180/realms/ticketflow"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-read-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}",
          "Methods": [ "GET" ]
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          { "PathRemovePrefix": "/catalog" }
        ]
      },
      "catalog-write-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/catalog/{**catch-all}"
        },
        "AuthorizationPolicy": "RequireAuthenticated",
        "Transforms": [
          { "PathRemovePrefix": "/catalog" }
        ]
      },
      "identity-register-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/register",
          "Methods": [ "POST" ]
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "AuthorizationPolicy": "RequireAuthenticated",
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/ordering/{**catch-all}"
        },
        "AuthorizationPolicy": "RequireAuthenticated",
        "Transforms": [
          { "PathRemovePrefix": "/ordering" }
        ]
      },
      "reservation-hub-route": {
        "ClusterId": "reservation-cluster",
        "Order": -1,
        "Match": {
          "Path": "/reservation/hubs/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          { "PathRemovePrefix": "/reservation" }
        ]
      },
      "reservation-route": {
        "ClusterId": "reservation-cluster",
        "Match": {
          "Path": "/reservation/{**catch-all}"
        },
        "AuthorizationPolicy": "RequireAuthenticated",
        "Transforms": [
          { "PathRemovePrefix": "/reservation" }
        ]
      },
      "search-route": {
        "ClusterId": "search-cluster",
        "Match": {
          "Path": "/search/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          { "PathRemovePrefix": "/search" }
        ]
      },
      "recommendation-route": {
        "ClusterId": "recommendation-cluster",
        "Match": {
          "Path": "/recommendation/{**catch-all}"
        },
        "AuthorizationPolicy": "anonymous",
        "Transforms": [
          { "PathRemovePrefix": "/recommendation" }
        ]
      },
      "analytics-route": {
        "ClusterId": "analytics-cluster",
        "Match": {
          "Path": "/analytics/{**catch-all}"
        },
        "AuthorizationPolicy": "RequireAuthenticated",
        "Transforms": [
          { "PathRemovePrefix": "/analytics" }
        ]
      },
      "ticketing-route": {
        "ClusterId": "ticketing-cluster",
        "Match": {
          "Path": "/ticketing/{**catch-all}"
        },
        "AuthorizationPolicy": "RequireAuthenticated",
        "Transforms": [
          { "PathRemovePrefix": "/ticketing" }
        ]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": {
            "Address": "http://catalog:8002"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity-api": {
            "Address": "http://identity:8001"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "ordering-api": {
            "Address": "http://ordering:8004"
          }
        }
      },
      "reservation-cluster": {
        "Destinations": {
          "reservation-api": {
            "Address": "http://reservation:8003"
          }
        }
      },
      "search-cluster": {
        "Destinations": {
          "search-api": {
            "Address": "http://search:8006"
          }
        }
      },
      "recommendation-cluster": {
        "Destinations": {
          "recommendation-api": {
            "Address": "http://recommendation:8009"
          }
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "analytics-api": {
            "Address": "http://analytics:8010"
          }
        }
      },
      "ticketing-cluster": {
        "Destinations": {
          "ticketing-api": {
            "Address": "http://ticketing:8008"
          }
        }
      }
    }
  },
  "Aws": {
    "LambdaServiceUrl": "http://ticketflow-localstack:4566"
  },
  "Elasticsearch": {
    "Uri": "http://elasticsearch:9200"
  },
  "Otlp": {
    "Endpoint": "http://ticketflow-jaeger:4317"
  }
}
